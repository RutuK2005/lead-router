# Copy to .env and adjust. Never commit the real .env.

# --- Storage ---
DATABASE_PATH=lead_router.db

# --- Inbound webhooks ---
# JSON object: source name -> HMAC signing secret. Sources without a secret are rejected.
# Generate real secrets with: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRETS={"meta": "dev-meta-secret", "website": "dev-website-secret", "generic": "dev-generic-secret"}
# Seconds a signed request stays valid (replay protection).
SIGNATURE_TOLERANCE_SECONDS=300
# Token you enter in the Meta app dashboard for the GET verification handshake.
META_VERIFY_TOKEN=dev-verify-token

# --- Cleaning / dedupe ---
DEFAULT_REGION=IN
DEDUPE_WINDOW_HOURS=24

# --- Scoring ---
# Leave empty to use the rule-based scorer only.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_TIMEOUT_SECONDS=20

# --- Outbound delivery ---
# JSON object: destination name -> webhook URL. Every non-spam lead goes to each one.
DESTINATIONS={"mock_crm": "http://127.0.0.1:9000/hook"}
# If set, outbound requests are signed with the same X-Timestamp/X-Signature scheme.
OUTBOUND_SIGNING_SECRET=
FORWARD_SPAM=false
DELIVERY_MAX_ATTEMPTS=6
DELIVERY_BASE_DELAY_SECONDS=2
DELIVERY_MAX_DELAY_SECONDS=300
DELIVERY_TIMEOUT_SECONDS=10
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_BATCH_SIZE=20

LOG_LEVEL=INFO
